# Export these variables before launch; .env is not automatically loaded by Python.
# Compose reads .env for interpolation. These defaults contain no real credentials.
JETSTREAM_URL=wss://jetstream.us-east.bsky.network/xrpc/network.bsky.jetstream.subscribeEvents
RAW_DIR=data/raw
QUEUE_SIZE=256
MAX_MESSAGE_BYTES=1048576
RAW_MAX_BYTES=16777216
RAW_ROTATE_SECONDS=300
BACKOFF_INITIAL=1
BACKOFF_MAX=30
METRICS_HOST=127.0.0.1
METRICS_PORT=8000
# PostgreSQL for live mode. Leave unset for raw-only ingestion. Demo uses a separate SQLite database.
DATABASE_URL=postgresql+psycopg://bluesky:local-development-only@127.0.0.1:5432/bluesky
DATABASE_RETRIES=5
DATABASE_RETRY_SECONDS=1
WINDOW_MINUTES=5
BASELINE_WINDOWS=12
ALPHA=2
BASELINE_FLOOR=1
MIN_CURRENT_COUNT=10
MIN_ABSOLUTE_INCREASE=5
MIN_RATE_RATIO=2
CANDIDATE_MIN_FREQUENCY=3
DETECT_INTERVAL_SECONDS=15
ANALYSIS_MAX_POSTS=1000000
# Raw files: six-hour TTL, checked at rotation and every idle minute.
RAW_RETENTION_HOURS=6
RAW_BUDGET_BYTES=1073741824
# Rolling source activity retention; cleanup every minute. Old event metadata is pruned too.
POST_RETENTION_HOURS=6
