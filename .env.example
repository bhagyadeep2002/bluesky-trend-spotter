# Export these variables before launch; .env is not automatically loaded.
JETSTREAM_URL=wss://jetstream.us-east.bsky.network/xrpc/network.bsky.jetstream.subscribeEvents
RAW_DIR=data/raw
QUEUE_SIZE=256
MAX_MESSAGE_BYTES=1048576
RAW_MAX_BYTES=16777216
RAW_ROTATE_SECONDS=300
BACKOFF_INITIAL=1
BACKOFF_MAX=30
METRICS_HOST=127.0.0.1
METRICS_PORT=8000
# Set DATABASE_URL to enable normalized storage. Leave unset for raw-only ingestion.
DATABASE_URL=postgresql+psycopg://bluesky:bluesky@127.0.0.1:5432/bluesky
DATABASE_RETRIES=5
DATABASE_RETRY_SECONDS=1
